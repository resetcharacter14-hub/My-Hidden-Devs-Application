--> 1. TweenModule:

local TweenModule = {}

local TweenService = game:GetService("TweenService")

function TweenModule:CreateTween(object, duration, style, direction, props)
	local easingStyle = Enum.EasingStyle[style] or Enum.EasingStyle.Quad
	local easingDirection = Enum.EasingDirection[direction] or Enum.EasingDirection.Out

	local tweenInfo = TweenInfo.new(
		duration,
		easingStyle,
		easingDirection
	)

	return TweenService:Create(object, tweenInfo, props)
end

return TweenModule


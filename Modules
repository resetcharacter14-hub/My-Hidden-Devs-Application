3. ModuleFinder:

local ModuleFinder = {}

local ModulesFolder = script.Parent:WaitForChild("Modules")
local Cache = {}

for _, module in ipairs(ModulesFolder:GetDescendants()) do
	if module:IsA("ModuleScript") then
		Cache[module.Name] = module
	end
end

function ModuleFinder.FindModule(moduleName)
	local module = Cache[moduleName]

	if not module then
		warn("Couldn't find module:", moduleName)
	end

	return require(module)
end

return ModuleFinder

